# Clés Stripe — récupère-les dans https://dashboard.stripe.com/test/apikeys
# Commence par les clés "Test mode" (préfixe pk_test_ / sk_test_).
# Quand tu es prêt à encaisser en vrai, remplace par les clés "Live mode" (pk_live_ / sk_live_)
# et configure-les dans les variables d'environnement de ton projet Vercel (pas dans ce fichier).

STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_PUBLISHABLE_KEY

# URL publique du site (utilisée pour les metadata Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://rootritual.com
